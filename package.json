{
  "name": "zhongdianjian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "中点见：异地亲友公平会合助手",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:config": "tsx scripts/check-config.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3088",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "verify:managed": "tsx scripts/verify-managed.ts",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "@fly-ai/flyai-cli": "1.0.16",
    "dotenv": "16.6.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.148.0"
  }
}
