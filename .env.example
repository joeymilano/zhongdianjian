# Managed Agent 核心接口；全部仅限服务端。
MANAGED_AGENT_API_KEY=
MANAGED_AGENT_BASE_URL=https://ws-YOURWORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/agentstudio
MANAGED_AGENT_ID=
# 文字专用 Managed Agent：工具、MCP、Skill 均为空，不接收飞猪凭据。
MANAGED_AGENT_TEXT_AGENT_ID=
MANAGED_AGENT_ENVIRONMENT_ID=
# vault：仅注入占位符；FlyAI CLI 1.0.16 的签名与网关替换不兼容。
MANAGED_AGENT_VAULT_ID=
# 如明确接受真实 Key 可被云端查询沙箱读取，设为 session_env。
# 未设置时保留 vault 模式；纯文本任务始终不传入旅行 Key。
MANAGED_AGENT_TRAVEL_AUTH=vault
FLYAI_API_KEY=
# 以下仅供独立模型诊断使用，不参与网页 Managed Agent 核心调用。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# 这里只设置整个项目的预算目标，不声称能替代云平台账单硬限额。
PROJECT_BUDGET_CNY=300
# 应用内保守调用额度上限；并非实际账单。正式部署需核对供应商单价。
API_BUDGET_CNY=200
FLYAI_CALL_RESERVE_CNY=1
BAILIAN_CALL_RESERVE_CNY=1
# 单 Node 进程的持久目录，部署时挂载持久卷。
DATA_DIR=.local
# 公开部署时填写准确 HTTPS origin，本地可留空。
# APP_ORIGIN=https://your-domain.example

# Same-city POI and routing: AMap Web service key, server-only
AMAP_API_KEY=
AMAP_CALL_RESERVE_CNY=1
